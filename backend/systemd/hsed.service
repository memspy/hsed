[Unit]
Description=Hidden Space Explorer daemon (unlinked-but-open file scanner)
Documentation=file:/usr/share/doc/hsed/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/sbin/hsedd --foreground --socket /run/hsed.sock
Restart=on-failure
RestartSec=2

User=root
Group=root

ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
