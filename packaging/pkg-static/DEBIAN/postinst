set -e

if [ "$1" = "configure" ]; then
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        echo "hsed installed. Start the backend daemon with:"
        echo "  sudo systemctl enable --now hsed"
    else
        echo "hsed installed. Start the backend daemon with:"
        echo "  sudo hsedd            (background)"
        echo "  sudo hsedd --foreground"
    fi
    echo "Then run: hsed"
fi

exit 0
