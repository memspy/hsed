
set -e

case "$1" in
    remove|purge)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl stop hsed >/dev/null 2>&1 || true
            systemctl disable hsed >/dev/null 2>&1 || true
        fi
        ;;
esac

if [ "$1" = "purge" ]; then
    rm -f /run/hsed.sock /run/hsed.pid
fi

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
